NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIRECRAWL_API_KEY=
# Bot protection on /cadastro and /login (Cloudflare Turnstile). Site key is public
# (goes in the widget on the page), secret key is verified server-side by Supabase
# Auth itself (configured in the Supabase dashboard, not read by this app's code) —
# leave both unset to render the forms without the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Curation WhatsApp (digits only, incl. country code), e.g. 5521999999999
NEXT_PUBLIC_CURATION_WHATSAPP=
# Only needed for one-off admin tasks via the Supabase CLI (db query/advisors/dump) —
# the ingestion executor itself never reads this. Personal Access Token, broad account
# scope — generate at supabase.com/dashboard/account/tokens, treat like a password.
SUPABASE_ACCESS_TOKEN=
# Live-write gate for the ingestion executor (lib/services/scraper/run-live-ingestion.ts)
# — leave unset/false for dry-run. See docs/INGESTAO_RUNBOOK.md before ever setting true.
INGESTION_LIVE_ENABLED=
